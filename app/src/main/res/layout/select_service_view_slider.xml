<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="150dp"
    android:layout_margin="10dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="5dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        >


        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">


            <androidx.cardview.widget.CardView
                android:id="@+id/time_line_card1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#F89E9D"
                app:cardCornerRadius="5dp"
                app:cardElevation="2dp">

                <TextView
                    android:id="@+id/time_line_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ETA 24 hrs"
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:padding="5dp"/>
            </androidx.cardview.widget.CardView>


            <ImageView
                android:id="@+id/image"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="10dp"
                android:layout_marginRight="5dp"
                android:layout_marginLeft="5dp"
                android:src="@drawable/tshirt"/>

        </RelativeLayout>



        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="10dp">



            <TextView
                android:id="@+id/service_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Regular Wash"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="@font/button"
                android:textColor="@color/text2"
                android:layout_marginTop="5dp"/>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">



                <TextView
                    android:text="Free Pickup &amp; Delivery"
                    android:textSize="14sp"
                    android:fontFamily="@font/button"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:textColor="@color/text3"/>

            </LinearLayout>


            <androidx.cardview.widget.CardView
                android:id="@+id/book_button"
                android:layout_gravity="end"
                android:layout_width="match_parent"
                android:padding="10dp"
                app:cardElevation="5dp"
                app:cardCornerRadius="15sp"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:layout_marginLeft="2dp"
                android:layout_marginRight="5dp"
                app:cardBackgroundColor="@color/blue"
                android:layout_marginBottom="5dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="Book Now"
                    android:padding="3dp"
                    android:fontFamily="@font/button"
                    android:textSize="20sp"
                    android:textAlignment="center"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    />
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>