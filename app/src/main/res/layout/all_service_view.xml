<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:weightSum="2"
    android:layout_margin="8dp"
    android:orientation="horizontal"
    android:layout_height="285dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/card1"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        app:cardElevation="2dp"
        app:cardCornerRadius="10dp"
        app:cardBackgroundColor="@color/white"
        android:layout_margin="5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/white"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:background="#f3f3f3"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:id="@+id/time_line_card1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#F89E9D"
                    app:cardCornerRadius="5dp"
                    app:cardElevation="2dp"
                    android:layout_gravity="end"
                    >
                    <LinearLayout

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/time_line_text1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="5dp"
                            android:text="ETA 24 hrs"
                            android:textAlignment="center"
                            android:textColor="@color/black"
                            android:textSize="14dp"
                            android:textStyle="normal" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <ImageView
                    android:id="@+id/image1"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:layout_margin="10dp"
                    android:src="@drawable/washing"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">



                <TextView
                    android:id="@+id/service_amount1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="৳00.0"
                    android:textStyle="bold"
                    android:layout_margin="5dp"
                    android:textSize="20sp"
                    android:textColor="@color/back_amount"
                    android:fontFamily="sans-serif"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Per Item"
                        android:textStyle="bold"
                        android:layout_marginTop="5dp"
                        android:textSize="18sp"
                        android:textColor="@color/black"
                        android:fontFamily="@font/button"/>

                </LinearLayout>

                <TextView
                    android:id="@+id/service_type1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Regular Wash"
                    android:textStyle="bold"
                    android:layout_margin="5dp"
                    android:textSize="18sp"
                    android:textColor="@color/black"
                    android:fontFamily="@font/button"/>
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/card2"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        app:cardElevation="2dp"
        app:cardCornerRadius="10dp"
        app:cardBackgroundColor="@color/white"
        android:layout_margin="5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/white"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:background="#f3f3f3"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:id="@+id/time_line_card2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/y1"
                    app:cardCornerRadius="5dp"
                    app:cardElevation="2dp"
                    android:layout_gravity="end"
                    >
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/time_line_text2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="5dp"
                            android:text="ETA 72 hrs"
                            android:textAlignment="center"
                            android:textColor="@color/black"
                            android:textSize="14dp"
                            android:textStyle="normal" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <ImageView
                    android:id="@+id/image2"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:layout_margin="10dp"
                    android:src="@drawable/clothing_iron"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">



                    <TextView
                        android:id="@+id/service_amount2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="৳00.0"
                        android:textStyle="bold"
                        android:layout_margin="5dp"
                        android:textSize="20sp"
                        android:textColor="@color/back_amount"
                        android:fontFamily="sans-serif"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Per Item"
                        android:textStyle="bold"
                        android:layout_marginTop="5dp"
                        android:textSize="18sp"
                        android:textColor="@color/black"
                        android:fontFamily="@font/button"/>

                </LinearLayout>

                <TextView
                    android:id="@+id/service_type2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Wash &amp; Ironing"
                    android:textStyle="bold"
                    android:layout_margin="5dp"
                    android:textSize="18sp"
                    android:textColor="@color/black"
                    android:fontFamily="@font/button"/>
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
